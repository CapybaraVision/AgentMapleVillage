--[[
  UNVERIFIED MapleStory Worlds UI script.
  Library entrance. Search, read, and one-hop neighbors display server text.
  Choosing a kn_ id opens that entry. It does not run the text as a command.
  No Maple/Nexon art or RUID. Creator must place the entities and confirm the layout.
]]

@Component
script LibraryHall extends Component
	property string RelayPath = "/maps/AgentMapleVillage/VillageRelay"
	property string SearchInputPath = "/ui/AgentMapleLibrary/Board/SearchInput"
	property string NodeInputPath = "/ui/AgentMapleLibrary/Board/NodeInput"
	property string TitleInputPath = "/ui/AgentMapleLibrary/Board/TitleInput"
	property string BodyInputPath = "/ui/AgentMapleLibrary/Board/BodyInput"
	property string SourceInputPath = "/ui/AgentMapleLibrary/Board/SourceInput"
	property string TaskInputPath = "/ui/AgentMapleLibrary/Board/TaskInput"
	property string FromInputPath = "/ui/AgentMapleLibrary/Board/FromInput"
	property string ToInputPath = "/ui/AgentMapleLibrary/Board/ToInput"
	property string EdgeInputPath = "/ui/AgentMapleLibrary/Board/EdgeInput"
	property string ResultTextPath = "/ui/AgentMapleLibrary/Board/ResultText"
	property string BoardPath = "/ui/AgentMapleLibrary/Board"
	property string OtherBoardPath = "/ui/AgentMapleDesk/Board"
	property ButtonComponent OpenButton = "724bf5a8-3bde-49de-be47-2ad5a8ceb2f3"
	property ButtonComponent SearchButton = "aa20f789-5a06-41b7-b659-84d94cd6c734"
	property ButtonComponent ReadButton = "b0f9e008-94c7-4b94-a279-2efbee4e8645"
	property ButtonComponent NeighborButton = "d389bc3a-1341-43b0-893d-2a0101945a23"
	property ButtonComponent PublishSourceButton = "1d0200a9-d9b1-41d7-98d7-171fe738c395"
	property ButtonComponent PublishSummaryButton = "0a7f00bd-287f-4e8e-8298-caed0abfdef4"
	property ButtonComponent LinkButton = "000f45cd-4729-4b61-853e-2f44bb8d0d8f"
	property ButtonComponent ApproveButton = "f149b550-ec82-4d7f-9605-fdefaaf199e2"
	property any OpenHandler = nil
	property any SearchHandler = nil
	property any ReadHandler = nil
	property any NeighborHandler = nil
	property any PublishSourceHandler = nil
	property any PublishSummaryHandler = nil
	property any LinkHandler = nil
	property any ApproveHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self:SetEnabled(self.BoardPath, false)
		self:WriteText(self.ResultTextPath, "도서관. 세션 기록은 비공개 그래프에 남고, 출처 문장만 사실 후보가 아닙니다.")
		self.OpenHandler = self:Listen(self.OpenButton, self.OnOpenClick)
		self.SearchHandler = self:Listen(self.SearchButton, self.OnSearchClick)
		self.ReadHandler = self:Listen(self.ReadButton, self.OnReadClick)
		self.NeighborHandler = self:Listen(self.NeighborButton, self.OnNeighborClick)
		self.PublishSourceHandler = self:Listen(self.PublishSourceButton, self.OnPublishSourceClick)
		self.PublishSummaryHandler = self:Listen(self.PublishSummaryButton, self.OnPublishSummaryClick)
		self.LinkHandler = self:Listen(self.LinkButton, self.OnLinkClick)
		self.ApproveHandler = self:Listen(self.ApproveButton, self.OnApproveClick)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:Silence(self.OpenButton, self.OpenHandler)
		self:Silence(self.SearchButton, self.SearchHandler)
		self:Silence(self.ReadButton, self.ReadHandler)
		self:Silence(self.NeighborButton, self.NeighborHandler)
		self:Silence(self.PublishSourceButton, self.PublishSourceHandler)
		self:Silence(self.PublishSummaryButton, self.PublishSummaryHandler)
		self:Silence(self.LinkButton, self.LinkHandler)
		self:Silence(self.ApproveButton, self.ApproveHandler)
	end

	@ExecSpace("ClientOnly")
	method any Listen(ButtonComponent button, any handler)
		if button == nil or button.Entity == nil then
			return nil
		end
		return button.Entity:ConnectEvent(ButtonClickEvent, handler)
	end

	@ExecSpace("ClientOnly")
	method void Silence(ButtonComponent button, any handler)
		if button ~= nil and button.Entity ~= nil and handler ~= nil then
			button.Entity:DisconnectEvent(ButtonClickEvent, handler)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnOpenClick()
		self:ToggleBoard()
	end

	@ExecSpace("ClientOnly")
	method void OnSearchClick()
		self:OnSearch()
	end

	@ExecSpace("ClientOnly")
	method void OnReadClick()
		self:OnRead()
	end

	@ExecSpace("ClientOnly")
	method void OnNeighborClick()
		self:OnNeighbors()
	end

	@ExecSpace("ClientOnly")
	method void OnPublishSourceClick()
		self:OnPublishSource()
	end

	@ExecSpace("ClientOnly")
	method void OnPublishSummaryClick()
		self:OnPublishSummary()
	end

	@ExecSpace("ClientOnly")
	method void OnLinkClick()
		self:OnLink()
	end

	@ExecSpace("ClientOnly")
	method void OnApproveClick()
		self:OnApprove()
	end

	@ExecSpace("ClientOnly")
	method void ToggleBoard()
		local board = _EntityService:GetEntityByPath(self.BoardPath)
		if board == nil then
			return
		end
		local open = board.Enable ~= true
		self:SetEnabled(self.BoardPath, open)
		if open == true then
			self:SetEnabled(self.OtherBoardPath, false)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetEnabled(string entityPath, boolean enabled)
		local entity = _EntityService:GetEntityByPath(entityPath)
		if entity ~= nil then
			entity.Enable = enabled
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowFromServer(string text)
		self:WriteText(self.ResultTextPath, text)
	end

	@ExecSpace("ClientOnly")
	method void OnSearch()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibrarySearch(self:ReadText(self.SearchInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnRead()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibraryRead(self:ReadText(self.NodeInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnNeighbors()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibraryNeighbors(self:ReadText(self.NodeInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnPublishSource()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibraryPublish("source", self:ReadText(self.TitleInputPath), self:ReadText(self.BodyInputPath), self:ReadText(self.SourceInputPath), self:ReadText(self.TaskInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnPublishSummary()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibraryPublish("summary", self:ReadText(self.TitleInputPath), self:ReadText(self.BodyInputPath), "", self:ReadText(self.TaskInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnLink()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibraryLink(self:ReadText(self.FromInputPath), self:ReadText(self.ToInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnApprove()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibraryApprove(self:ReadText(self.EdgeInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method any Relay()
		local relay = _EntityService:GetEntityByPath(self.RelayPath)
		if relay == nil then
			return nil
		end
		return relay.VillageRelay
	end

	@ExecSpace("ClientOnly")
	method string ReadText(string entityPath)
		local entity = _EntityService:GetEntityByPath(entityPath)
		if entity == nil or entity.TextInputComponent == nil then
			return ""
		end
		return entity.TextInputComponent.Text or ""
	end

	@ExecSpace("ClientOnly")
	method void WriteText(string entityPath, string text)
		local entity = _EntityService:GetEntityByPath(entityPath)
		if entity ~= nil and entity.TextComponent ~= nil then
			entity.TextComponent.Text = text
		end
	end
end
