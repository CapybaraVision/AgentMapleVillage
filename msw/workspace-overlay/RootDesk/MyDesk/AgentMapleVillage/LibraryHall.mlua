--[[
  UNVERIFIED MapleStory Worlds UI script.
  Library entrance. Search, read, and one-hop neighbors display server text.
  Choosing a kn_ id opens that entry. It does not run the text as a command.
  No Maple/Nexon art or RUID. Creator must place the entities and confirm the layout.
]]

@Component
script LibraryHall extends Component
	property string RelayPath = "/maps/AgentMapleVillage/VillageRelay"
	property string SearchInputPath = "/ui/AgentMapleLibrary/Board/SearchInput"
	property string NodeInputPath = "/ui/AgentMapleLibrary/Board/NodeInput"
	property string TitleInputPath = "/ui/AgentMapleLibrary/Board/TitleInput"
	property string BodyInputPath = "/ui/AgentMapleLibrary/Board/BodyInput"
	property string SourceInputPath = "/ui/AgentMapleLibrary/Board/SourceInput"
	property string TaskInputPath = "/ui/AgentMapleLibrary/Board/TaskInput"
	property string FromInputPath = "/ui/AgentMapleLibrary/Board/FromInput"
	property string ToInputPath = "/ui/AgentMapleLibrary/Board/ToInput"
	property string EdgeInputPath = "/ui/AgentMapleLibrary/Board/EdgeInput"
	property string ResultTextPath = "/ui/AgentMapleLibrary/Board/ResultText"
	property string BoardPath = "/ui/AgentMapleLibrary/Board"
	property string OtherBoardPath = "/ui/AgentMapleDesk/Board"
	property ButtonComponent OpenButton = "1d4c683e-445b-49e4-bb1f-cde16d6fa585"
	property ButtonComponent SearchButton = "d49d40d5-69a3-45d4-a9f3-5f8f33896839"
	property ButtonComponent ReadButton = "1d619c74-ee0b-4433-8af3-c363b8e3afec"
	property ButtonComponent NeighborButton = "cdb58983-3b90-499a-8173-968513aa5b34"
	property ButtonComponent PublishSourceButton = "a30a69d7-a22d-49ec-b435-67862cd5cf67"
	property ButtonComponent PublishSummaryButton = "f0b482dd-0986-48c1-ae4c-3eed304c6b2c"
	property ButtonComponent LinkButton = "9d02adb7-d19d-4ff6-bd79-a1994069912f"
	property ButtonComponent ApproveButton = "af233762-fff8-4a50-9497-ef8d35554071"
	property any OpenHandler = nil
	property any SearchHandler = nil
	property any ReadHandler = nil
	property any NeighborHandler = nil
	property any PublishSourceHandler = nil
	property any PublishSummaryHandler = nil
	property any LinkHandler = nil
	property any ApproveHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self:SetEnabled(self.BoardPath, false)
		self:WriteText(self.ResultTextPath, "도서관. 세션 기록은 비공개 그래프에 남고, 출처 문장만 사실 후보가 아닙니다.")
		if self.OpenButton ~= nil and self.OpenButton.Entity ~= nil then
			self.OpenHandler = self.OpenButton.Entity:ConnectEvent(ButtonClickEvent, self.OnOpenClick)
		end
		if self.SearchButton ~= nil and self.SearchButton.Entity ~= nil then
			self.SearchHandler = self.SearchButton.Entity:ConnectEvent(ButtonClickEvent, self.OnSearchClick)
		end
		if self.ReadButton ~= nil and self.ReadButton.Entity ~= nil then
			self.ReadHandler = self.ReadButton.Entity:ConnectEvent(ButtonClickEvent, self.OnReadClick)
		end
		if self.NeighborButton ~= nil and self.NeighborButton.Entity ~= nil then
			self.NeighborHandler = self.NeighborButton.Entity:ConnectEvent(ButtonClickEvent, self.OnNeighborClick)
		end
		if self.PublishSourceButton ~= nil and self.PublishSourceButton.Entity ~= nil then
			self.PublishSourceHandler = self.PublishSourceButton.Entity:ConnectEvent(ButtonClickEvent, self.OnPublishSourceClick)
		end
		if self.PublishSummaryButton ~= nil and self.PublishSummaryButton.Entity ~= nil then
			self.PublishSummaryHandler = self.PublishSummaryButton.Entity:ConnectEvent(ButtonClickEvent, self.OnPublishSummaryClick)
		end
		if self.LinkButton ~= nil and self.LinkButton.Entity ~= nil then
			self.LinkHandler = self.LinkButton.Entity:ConnectEvent(ButtonClickEvent, self.OnLinkClick)
		end
		if self.ApproveButton ~= nil and self.ApproveButton.Entity ~= nil then
			self.ApproveHandler = self.ApproveButton.Entity:ConnectEvent(ButtonClickEvent, self.OnApproveClick)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.OpenButton ~= nil and self.OpenButton.Entity ~= nil and self.OpenHandler ~= nil then
			self.OpenButton.Entity:DisconnectEvent(ButtonClickEvent, self.OpenHandler)
		end
		if self.SearchButton ~= nil and self.SearchButton.Entity ~= nil and self.SearchHandler ~= nil then
			self.SearchButton.Entity:DisconnectEvent(ButtonClickEvent, self.SearchHandler)
		end
		if self.ReadButton ~= nil and self.ReadButton.Entity ~= nil and self.ReadHandler ~= nil then
			self.ReadButton.Entity:DisconnectEvent(ButtonClickEvent, self.ReadHandler)
		end
		if self.NeighborButton ~= nil and self.NeighborButton.Entity ~= nil and self.NeighborHandler ~= nil then
			self.NeighborButton.Entity:DisconnectEvent(ButtonClickEvent, self.NeighborHandler)
		end
		if self.PublishSourceButton ~= nil and self.PublishSourceButton.Entity ~= nil and self.PublishSourceHandler ~= nil then
			self.PublishSourceButton.Entity:DisconnectEvent(ButtonClickEvent, self.PublishSourceHandler)
		end
		if self.PublishSummaryButton ~= nil and self.PublishSummaryButton.Entity ~= nil and self.PublishSummaryHandler ~= nil then
			self.PublishSummaryButton.Entity:DisconnectEvent(ButtonClickEvent, self.PublishSummaryHandler)
		end
		if self.LinkButton ~= nil and self.LinkButton.Entity ~= nil and self.LinkHandler ~= nil then
			self.LinkButton.Entity:DisconnectEvent(ButtonClickEvent, self.LinkHandler)
		end
		if self.ApproveButton ~= nil and self.ApproveButton.Entity ~= nil and self.ApproveHandler ~= nil then
			self.ApproveButton.Entity:DisconnectEvent(ButtonClickEvent, self.ApproveHandler)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnOpenClick()
		self:ToggleBoard()
	end

	@ExecSpace("ClientOnly")
	method void OnSearchClick()
		self:OnSearch()
	end

	@ExecSpace("ClientOnly")
	method void OnReadClick()
		self:OnRead()
	end

	@ExecSpace("ClientOnly")
	method void OnNeighborClick()
		self:OnNeighbors()
	end

	@ExecSpace("ClientOnly")
	method void OnPublishSourceClick()
		self:OnPublishSource()
	end

	@ExecSpace("ClientOnly")
	method void OnPublishSummaryClick()
		self:OnPublishSummary()
	end

	@ExecSpace("ClientOnly")
	method void OnLinkClick()
		self:OnLink()
	end

	@ExecSpace("ClientOnly")
	method void OnApproveClick()
		self:OnApprove()
	end

	@ExecSpace("ClientOnly")
	method void ToggleBoard()
		local board = _EntityService:GetEntityByPath(self.BoardPath)
		if board == nil then
			return
		end
		local open = board.Enable ~= true
		self:SetEnabled(self.BoardPath, open)
		if open == true then
			self:SetEnabled(self.OtherBoardPath, false)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetEnabled(string entityPath, boolean enabled)
		local entity = _EntityService:GetEntityByPath(entityPath)
		if entity ~= nil then
			entity.Enable = enabled
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowFromServer(string text)
		self:WriteText(self.ResultTextPath, text)
	end

	@ExecSpace("ClientOnly")
	method void OnSearch()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibrarySearch(self:ReadText(self.SearchInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnRead()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibraryRead(self:ReadText(self.NodeInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnNeighbors()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibraryNeighbors(self:ReadText(self.NodeInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnPublishSource()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibraryPublish("source", self:ReadText(self.TitleInputPath), self:ReadText(self.BodyInputPath), self:ReadText(self.SourceInputPath), self:ReadText(self.TaskInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnPublishSummary()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibraryPublish("summary", self:ReadText(self.TitleInputPath), self:ReadText(self.BodyInputPath), "", self:ReadText(self.TaskInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnLink()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibraryLink(self:ReadText(self.FromInputPath), self:ReadText(self.ToInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnApprove()
		local relay = self:Relay()
		if relay ~= nil then
			relay:SubmitLibraryApprove(self:ReadText(self.EdgeInputPath))
		end
	end

	@ExecSpace("ClientOnly")
	method any Relay()
		local relay = _EntityService:GetEntityByPath(self.RelayPath)
		if relay == nil then
			return nil
		end
		return relay.VillageRelay
	end

	@ExecSpace("ClientOnly")
	method string ReadText(string entityPath)
		local entity = _EntityService:GetEntityByPath(entityPath)
		if entity == nil or entity.TextInputComponent == nil then
			return ""
		end
		return entity.TextInputComponent.Text or ""
	end

	@ExecSpace("ClientOnly")
	method void WriteText(string entityPath, string text)
		local entity = _EntityService:GetEntityByPath(entityPath)
		if entity ~= nil and entity.TextComponent ~= nil then
			entity.TextComponent.Text = text
		end
	end
end
