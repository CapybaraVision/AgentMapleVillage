--[[
  UNVERIFIED MapleStory Worlds script source.
  Put this on each office NPC (foreman and worker) and name the script OfficeNpc.
  The relay sets Station and ActivityText. This script only moves the NPC.
  There is no navmesh here: it steps in a straight line. Creator must verify movement.
  No Maple/Nexon assets are referenced.
]]

@Component
script OfficeNpc extends Component
	property string SessionId = "ses_worker"
	property string Station = "home"
	property string ActivityText = "집에서 쉬는 중"
	property string OwnerUserId = ""
	property boolean CaptureOwnerOnNextEnter = false
	property number DeskX = 0
	property number DeskY = 0
	property number HomeX = 0
	property number MeetingX = 0
	property number ApproachOffset = 1.2
	property number FloorY = 0
	property boolean Pace = true
	property number PaceDir = 1
	property boolean DeskSaved = false
	property string SlotLabel = ""
	property number LibraryX = 0
	property number MoveSpeed = 2.5

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		if self.DeskSaved == false then
			local pos = self.Entity.TransformComponent.WorldPosition
			self.FloorY = pos.y
			self.DeskY = pos.y
			self.HomeX = pos.x
			self.DeskSaved = true
		end
		local tick = function()
			self:Step(0.1)
		end
		_TimerService:SetTimerRepeat(tick, 0.1)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Service", "UserService")
	handler HandleUserEnterEvent(UserEnterEvent event)
		-- UserService has no world-owner field. ProfileCode is not a relay credential.
		-- The first player is not the owner unless the creator arms this switch.
		if self.CaptureOwnerOnNextEnter == true and self.OwnerUserId == "" then
			self.OwnerUserId = event.UserId
			self.CaptureOwnerOnNextEnter = false
		end
	end

	@ExecSpace("ServerOnly")
	method void Step(number delta)
		-- Horizontal input only. MoveToDirection is the documented MovementComponent call.
		-- The body keeps the entity on the tile or foothold. This is not pathfinding and not a walk clip.
		local targetX = self.HomeX
		if self.Station == "desk" then
			targetX = self.DeskX
		elseif self.Station == "meeting" then
			targetX = self.MeetingX
		elseif self.Station == "library" then
			targetX = self.LibraryX
		elseif self.Station == "user" and self.OwnerUserId ~= "" then
			local userEntity = _UserService:GetUserEntityByUserId(self.OwnerUserId)
			if userEntity ~= nil and userEntity.TransformComponent ~= nil then
				targetX = userEntity.TransformComponent.WorldPosition.x + self.ApproachOffset
			end
		elseif self.Station == "home" and self.Pace == true then
			targetX = self.HomeX + (self.PaceDir * 0.35)
		end
		local pos = self.Entity.TransformComponent.WorldPosition
		local dx = targetX - pos.x
		if dx < 0.15 and dx > -0.15 then
			if self.Station == "home" and self.Pace == true then
				self.PaceDir = self.PaceDir * -1
			end
			self.Entity.MovementComponent:Stop()
			return
		end
		local direction = 1
		if dx < 0 then
			direction = -1
		end
		self.Entity.MovementComponent.InputSpeed = self.MoveSpeed
		self.Entity.MovementComponent:MoveToDirection(Vector2(direction, 0), delta)
	end
end
